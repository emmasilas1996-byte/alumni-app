# SQL Server connection string
# Format: sqlserver://HOST:PORT;database=DBNAME;user=USER;password=PASSWORD;trustServerCertificate=true
DATABASE_URL="sqlserver://localhost:1433;database=AlumniApp;user=AlumniApp;password=AlumniApp;trustServerCertificate=true"

# 32-byte key, base64-encoded — used to encrypt/decrypt every uploaded image
# and email/phone field. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY="4oYWIlMymDasKCXofCN/gB73Tf23GEf/l48iFqzylxA="

# Random long string used to sign login session cookies
JWT_SECRET="X5+EXgCbCo5ifS73Ws6mNaq3wBz0+sfovfAJjL7qzkA="

# Gmail SMTP — use an App Password, not your real Gmail password
# (Google Account > Security > 2-Step Verification > App Passwords)
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Shared secret so only your scheduler can trigger the cron endpoints
CRON_SECRET="pHB1i/n+W+2egWsNeHbHr3jo2jRS73ZCuR8d2kYMwL0="

# Paystack — from your Paystack dashboard (Settings > API Keys & Webhooks).
# Your UBA account is registered as the settlement account INSIDE Paystack's
# dashboard, not here — this app never stores your bank account number.
